# Optional generation is disabled unless explicitly enabled by the operator.
LAB_GENERATION_ENABLED=0
LAB_GENERATION_BASE_URL=http://127.0.0.1:8000/v1
LAB_GENERATION_MODEL=YOUR_SERVED_MODEL
# Supply a real key only through your private environment or secret manager.
LAB_GENERATION_API_KEY=
LAB_GENERATION_FORMAT=json_schema
LAB_GENERATION_TIMEOUT=10
LAB_GENERATION_MAX_TOKENS=512
LAB_GENERATION_TOKEN_FIELD=max_tokens

# Independent agent opt-in. No generation/benchmark credential fallback.
LAB_AGENT_ENABLED=0
LAB_AGENT_BASE_URL=http://127.0.0.1:8000/v1
LAB_AGENT_MODEL=YOUR_SERVED_MODEL
LAB_AGENT_API_KEY=
LAB_AGENT_FORMAT=json_schema
LAB_AGENT_TIMEOUT=10
LAB_AGENT_MAX_TOKENS=256
LAB_AGENT_TOKEN_FIELD=max_tokens
